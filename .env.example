# ===== LLM provider (pick ONE) ==============================================
# Groq (default). Key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here
EXORA_MODEL=groq/openai/gpt-oss-120b
# true only if the model accepts images (enables screenshots and pixel clicking)
EXORA_MODEL_VISION=false

# --- Alternatives (LiteLLM model strings; check the provider docs for exact IDs, untested here) ---
# OPENAI_API_KEY=sk-your-key
# EXORA_MODEL=openai/<model-id>
# ANTHROPIC_API_KEY=sk-ant-your-key
# EXORA_MODEL=anthropic/<model-id>
# Gemini (native ADK): GOOGLE_API_KEY=your-key  and  EXORA_MODEL=gemini-2.5-flash  and  EXORA_MODEL_VISION=true

# ===== Safety sandbox =======================================================
# Folders the file tools may read/write (; on Windows, : on macOS/Linux)
EXORA_ALLOWED_ROOTS=~
EXORA_DOWNLOAD_DIR=~/Downloads
EXORA_SCREENSHOT_DIR=./runs/screenshots

# ===== Browser ==============================================================
# "chrome" or "msedge" to drive an installed browser; empty = bundled Chromium
EXORA_BROWSER_CHANNEL=
EXORA_BROWSER_HEADLESS=false

# ===== Runtime ==============================================================
# Hard cap on model calls per task (runaway protection)
EXORA_MAX_LLM_CALLS=80
# Persistent ADK sessions, e.g. sqlite+aiosqlite:///./exora_sessions.db (empty = in memory)
EXORA_SESSION_DB=
# Shrink tool descriptions for non-Gemini models (saves tokens)
EXORA_SLIM_TOOLS=true

# ===== Docker / UI ==========================================================
EXORA_PORT=8501
